{
  "name": "@dynamicagency/throughline-opencode",
  "version": "0.15.0",
  "description": "OpenCode plugin for throughline session memory",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "Dynamic Agency",
    "email": "support@dynamicagency.com"
  },
  "homepage": "https://github.com/dynamic/throughline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynamic/throughline.git",
    "directory": ".opencode-plugin"
  },
  "bugs": "https://github.com/dynamic/throughline/issues",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "memory",
    "handoff",
    "session",
    "context",
    "continuity",
    "compaction",
    "git-state",
    "cross-harness",
    "resume",
    "onboarding"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
