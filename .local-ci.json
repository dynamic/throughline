{
  "checks": [
    {
      "label": "shellcheck",
      "run": "shellcheck -s sh hooks/*.sh tests/*.sh scripts/*.sh"
    },
    {
      "label": "manifests and versions",
      "run": "sh scripts/check-manifests.sh"
    },
    {
      "label": "typography",
      "run": "sh scripts/check-typography.sh"
    },
    {
      "label": "hook tests",
      "run": "sh tests/run.sh"
    },
    {
      "label": "opencode plugin",
      "run": "cd .opencode-plugin && npm ci && npm run typecheck && npm test"
    },
    {
      "label": "hermes plugin",
      "run": "python3 -m pytest tests/hermes -q"
    },
    {
      "label": "omp plugin",
      "run": "cd .omp-plugin && bun install --frozen-lockfile && bun run typecheck && bun test"
    }
  ]
}
